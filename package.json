{
  "name": "rss-generator",
  "version": "0.1.0",
  "description": "Generate a static feed.xml from notes marked rss: true, for use with any static site generator.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "rss"
  ],
  "author": "jackydangelo",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.1.0",
    "obsidian": "^1.5.0",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  }
}
